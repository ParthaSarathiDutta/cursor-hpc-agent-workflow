{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dashboard: Start",
      "type": "shell",
      "command": "./scripts/dashboard-dev.sh ensure && ./scripts/dashboard-dev.sh open",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": false,
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "Dashboard: Stop",
      "type": "shell",
      "command": "./scripts/dashboard-dev.sh stop",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Dashboard: Status",
      "type": "shell",
      "command": "./scripts/check-dashboard.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Dashboard: Open in browser",
      "type": "shell",
      "command": "./scripts/dashboard-dev.sh open",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    }
  ]
}
