ssh_host: perlmutter
blast_root: /global/cfs/cdirs/m4597/partha/AgenticBLAST
local_cache: ~/blast-runs-cache
gpu_account: YOUR_GPU_ACCOUNT_g
slurm_script: slurm/blast_train.slurm
trial_target: 1000
run_folders:
  - ML-Tersoff-1_PE
  - ML-Tersoff-1_PE_12
  - ML-Tersoff-1_PE_hybrid
# Optional: notify_email: you@example.com  (email findings — scaffold)
dashboard_url: http://127.0.0.1:8501
# google_api_key: YOUR_KEY   # optional — prefer repo-root .env (auto-loaded at startup)
gemini_model: gemini-3.6-flash   # or GEMINI_MODEL in .env. Fallbacks: gemini-3.1-flash-lite, gemini-2.0-flash
chat_context_top_k: 5   # top N trials per folder sent to Agent Chat (increase for "top 10" questions)
status_board_path: .cursor/status/board.json
plans_dir: .cursor/plans
# AgenticBLAST job launch (see docs/agenticblast-submit.md)
input_txt_name: input.txt
run_dir_glob: ML-Tersoff*
blast_python: /global/cfs/cdirs/m1917/blast_ff/bin/miniconda3/bin/python
submit_account: m3794
salloc_nodes: 2
salloc_time: "00:10:00"
salloc_ntasks_per_node: 4
salloc_gpus_per_task: 1
salloc_gpus: 8
salloc_qos: interactive
batch_slurm_script: slurm/agenticblast_runBOP.slurm
batch_slurm_remote_name: agenticblast_runBOP.slurm
batch_qos: regular
batch_time: "04:00:00"
batch_nodes: 2
batch_ntasks_per_node: 4
batch_gpus_per_task: 1
batch_gpus: 8
launch_ssh_timeout_sec: 14400
